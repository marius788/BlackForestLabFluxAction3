<?xml version="1.0" encoding="utf-8"?>
<!-- Chess pieces for the NexArm tabletop; included by chess_scene.xml. Each piece is a free
     body made of ONE solid cylinder, so the jaws (contype 8 / conaffinity 11, 30 mm tall) have a
     tall constant-radius wall to close on anywhere along the height - a thin wide base let them
     contact only the bottom rim, foul the board and squeeze the piece out. The 6-8 mm radius
     clears the 25 mm squares. Contype 2 / conaffinity 3 is the same handshake as the cube and
     bowls. -->
<mujoco model="NexArm chess pieces">
  <default>
    <default class="chess_piece">
      <geom type="cylinder" contype="2" conaffinity="3" friction="1.5 0.01 0.001" />
    </default>
  </default>
  <asset>
    <material name="piece_white" rgba="0.94 0.93 0.90 1" specular="0.5" shininess="0.35" roughness="0.35" />
    <material name="piece_black" rgba="0.10 0.10 0.12 1" specular="0.4" shininess="0.3" roughness="0.4" />
  </asset>
  <worldbody>
