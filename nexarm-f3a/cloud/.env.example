# Copy to nexarm-f3a/cloud/.env (gitignored) and fill in. Never commit real tokens or keys.

# --- AI Galaxy instance SSH (from https://gpu.ai-galaxy.com/store -> My Instances) ---
SSH_HOST=
SSH_PORT=
SSH_USER=root
# Optional: path to private SSH key (defaults to ~/.ssh/id_ed25519 if present)
SSH_KEY_PATH=
# Persistent data mount with >= 80-120 GB free (check on the instance via `df -h && lsblk`, e.g. /root/data/nexarm or /workspace)
REMOTE_DIR=/root/data/nexarm

# --- Hugging Face (read token with access to black-forest-labs/flux-3-action-so101 AND flux-3-action-base) ---
HF_TOKEN=
# Recommended in mainland China (also requires HF_HUB_DISABLE_XET=1 for huggingface-hub 2.4.0):
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# --- Optional China download mirrors (leave blank to use upstream defaults) ---
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
UV_PYTHON_INSTALL_MIRROR=https://registry.npmmirror.com/-/binary/python-build-standalone/
PYTORCH_INDEX_URL=https://mirror.nju.edu.cn/pytorch/whl/cu128
LEROBOT_GIT_URL=https://github.com/huggingface/lerobot.git
HTTP_PROXY=
HTTPS_PROXY=
